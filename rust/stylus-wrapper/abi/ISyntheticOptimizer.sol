pragma solidity 0.8.30;

/// Client interface for the synthetic evaluator. This is independently
/// maintained, not generated by the Stylus SDK exporter.
interface ISyntheticOptimizer {
    struct SyntheticAsset {
        string namespace;
        string identifier;
        uint8 decimals;
    }

    struct SyntheticCandidate {
        bytes32 routeId;
        bytes32 snapshotId;
        uint128 rateNumerator;
        uint128 rateDenominator;
        uint16 feeBps;
        uint16 estimatedImpactBps;
        uint128 minInput;
        uint128 maxInput;
        uint128 availableInput;
        uint128 availableOutput;
        uint128 executionCostUsdCents;
        uint64 expiresAtUnixSeconds;
    }

    struct SyntheticRequest {
        uint16 version;
        uint8 mode;
        SyntheticAsset inputAsset;
        SyntheticAsset outputAsset;
        uint128 amountIn;
        uint128 userMinOut;
        uint16 toleranceBps;
        uint64 asOfUnixSeconds;
        uint64 expiresAtUnixSeconds;
        bytes32 snapshotId;
        SyntheticCandidate[] candidates;
    }

    struct Rejection {
        bytes32 routeId;
        string reason;
    }

    struct SyntheticResult {
        uint8 status;
        string errorCode;
        bytes32 selectedRouteId;
        uint128 amountIn;
        uint128 grossOut;
        uint128 feeOut;
        uint128 expectedOut;
        uint128 minimumOut;
        uint128 executionCostUsdCents;
        uint64 effectiveExpiry;
        bytes32 snapshotId;
        uint8 evaluatedCount;
        Rejection[] rejected;
    }

    function evaluateSynthetic(SyntheticRequest calldata request)
        external view returns (SyntheticResult memory);
}
