# Local simulation ONLY. Never enable dev authentication on a public server.
DATABASE_URL=postgres://ponte:local-only@localhost:54329/ponte
NODE_ENV=development
PONTE_DEV_AUTH=1
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PONTE_DEV_TOKEN=
PONTE_DEV_BUSINESS_ID=00000000-0000-4000-8000-000000000001
PONTE_DEV_USER_ID=00000000-0000-4000-8000-000000000002

# Disabled by default. These two values are required together only to exercise
# the local evidence-persistence integration against a loopback database.
# It uses a synthetic test provider, not a production KMS or deployed registry.
# PONTE_LOCAL_EVIDENCE_TEST_PROVIDER=1
# PONTE_LOCAL_EVIDENCE_TEST_REGISTRY_ADDRESS=
