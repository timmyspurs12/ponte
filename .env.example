# Local simulation ONLY. Never enable dev authentication on a public server.
DATABASE_URL=postgres://ponte:local-only@localhost:54329/ponte
NODE_ENV=development
PONTE_DEV_AUTH=1
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PONTE_DEV_TOKEN=
PONTE_DEV_BUSINESS_ID=00000000-0000-4000-8000-000000000001
PONTE_DEV_USER_ID=00000000-0000-4000-8000-000000000002

# Disabled by default. These two values are required together only to exercise
# the local evidence-persistence integration against a loopback database.
# It uses a synthetic test provider, not a production KMS or deployed registry.
# PONTE_LOCAL_EVIDENCE_TEST_PROVIDER=1
# PONTE_LOCAL_EVIDENCE_TEST_REGISTRY_ADDRESS=

# Production GitHub OAuth (server-only; do not put these in NEXT_PUBLIC_* or
# commit a populated file). Production ignores every PONTE_DEV_* value.
# AUTH_SECRET=                    # 32–512 printable characters; generate/store outside this repo
# AUTH_GITHUB_ID=                 # GitHub OAuth App client ID
# AUTH_GITHUB_SECRET=             # GitHub OAuth App client secret
# NEXTAUTH_URL=https://app.example.com  # canonical HTTPS production origin
# AUTH_URL=https://app.example.com      # optional Auth.js v5 alias; if set, must exactly match NEXTAUTH_URL
# PONTE_AUTH_BUSINESS_ID=         # existing private business UUID; it is never created by login
# PONTE_AUTH_ADMIN_GITHUB_IDS=    # comma-separated immutable numeric GitHub account IDs, e.g. 123,456
# PONTE_PUBLIC_DEMO_READ_ONLY=0   # set exactly 1 only to enable the synthetic public demo tenant
# PONTE_PUBLIC_DEMO_BUSINESS_ID=  # required with PONTE_PUBLIC_DEMO_READ_ONLY=1; must differ from admin business
