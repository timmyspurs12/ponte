{
  "name": "ponte",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "format": "prettier --write src tests playwright.config.ts",
    "test:install": "playwright install chromium",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/database.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/database.ts --seed",
    "db:fixtures": "node --env-file-if-exists=.env.local --import tsx scripts/seed-fixtures.ts",
    "test:backend": "node --env-file-if-exists=.env.local --import tsx --test tests-backend/*.test.ts",
    "db:reset": "node --env-file-if-exists=.env.local --import tsx scripts/reset-database.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
